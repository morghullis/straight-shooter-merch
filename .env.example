# Copy to .env.local and fill in. With these unset the store runs on the demo catalog.

# Your Shopify store domain, e.g. my-store.myshopify.com
SHOPIFY_STORE_DOMAIN=

# Storefront API access token (Shopify admin > Settings > Apps and sales channels > Develop apps).
# Needs: unauthenticated_read_product_listings, unauthenticated_read_product_inventory,
# unauthenticated_read_product_tags, unauthenticated_write_checkouts, unauthenticated_read_checkouts.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Optional. Defaults to 2026-07.
SHOPIFY_API_VERSION=

# Signing secret for the webhook receiver at /api/revalidate (Shopify admin > Settings >
# Notifications > Webhooks). Unset = the route answers 501 and the cache refreshes hourly.
SHOPIFY_WEBHOOK_SECRET=

# Optional. Customer account sign-in URL used by the account page.
NEXT_PUBLIC_SHOPIFY_ACCOUNT_URL=

# Public URL of the deployed site (used for metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Where "Join the crew" posts { email, source, at } as JSON (your email provider's
# form endpoint, Zapier, n8n...). Unset = the form reports demo mode and saves nothing.
FAN_SIGNUP_WEBHOOK=
