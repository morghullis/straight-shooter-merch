# Copy to .env.local and fill in. With these unset the store runs on the demo catalog.

# Your Shopify store domain, e.g. my-store.myshopify.com
SHOPIFY_STORE_DOMAIN=

# Storefront API token: Shopify admin > Sales channels > Headless > your storefront > Storefront API tokens.
# Use the private access token (shpat_…, server only); a public token also works.
# Storefront API permissions needed: unauthenticated_read_product_listings, unauthenticated_read_product_inventory,
# unauthenticated_read_product_tags, unauthenticated_write_checkouts, unauthenticated_read_checkouts.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Optional. Defaults to 2026-07.
SHOPIFY_API_VERSION=

# Signing secret for the webhook receiver at /api/revalidate. For webhooks registered with
# tools/pipeline/register-webhooks.mjs it is the Dev Dashboard app's client secret.
# Unset = the route answers 501 and the cache refreshes hourly.
SHOPIFY_WEBHOOK_SECRET=

# Optional. Start the asset pipeline (.github/workflows/product-assets.yml) as soon as a product is
# created or gets a photo: a GitHub fine-grained token with Contents read and write on the
# repository, and the repository as owner/name. Unset = the pipeline's 10-minute check picks it up.
GITHUB_DISPATCH_TOKEN=
GITHUB_DISPATCH_REPO=

# Optional. Customer accounts on the site (sign in, orders, signed-in checkout): Shopify admin >
# Sales channels > Headless > your storefront > Customer Account API settings > Client ID. Set the
# client secret too only for a Confidential client. Unset = the account buttons open Shopify's own
# account pages (https://<store domain>/account).
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_SECRET=

# Public URL of the deployed site (used for metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Where "Join the crew" posts { email, source, at } as JSON (your email provider's
# form endpoint, Zapier, n8n...). Unset = the form reports demo mode and saves nothing.
FAN_SIGNUP_WEBHOOK=

# Optional. Set to 1 on preview deployments to keep them out of search engines (adds a noindex robots tag).
SITE_PREVIEW=
